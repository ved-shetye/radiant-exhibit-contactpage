    };

    // Build Clean Initial Welcome Message HTML (No Button Options Initially)
    function getWelcomeHTML() {
      return `
        <div class="msg-row bot">
          <div class="bubble">Hi 👋 Welcome to <strong>Radiant Exhibits</strong>! How can I help you today? Feel free to ask about our booth dimensions, custom designs, rentals, pricing, or on-site services.</div>
        </div>
      `;
    }

    // Initialize messages container with clean welcome
    msgContainer.innerHTML = getWelcomeHTML();

    // Toggle Chat Window
    bubble.addEventListener("click", () => {
      windowEl.classList.add("active");
      bubble.classList.add("hidden-bubble");
      if (input) setTimeout(() => input.focus(), 200);
    });

    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        windowEl.classList.remove("active");
        bubble.classList.remove("hidden-bubble");
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        msgContainer.innerHTML = getWelcomeHTML();
      });
    }

    // Delegated click handler on msgContainer: handles ALL interactive chips & redirect buttons reliably
    msgContainer.addEventListener("click", (e) => {
      // 1. Handle Chip Button Click
      const chip = e.target.closest(".chat-chip-btn");
      if (chip) {
        e.preventDefault();
        const intent = chip.getAttribute("data-intent");
        const query = chip.getAttribute("data-query") || chip.textContent.trim();
        handleUserQuery(query, intent);
        return;
      }

      // 2. Handle Action Redirect Button Click
      const actionBtn = e.target.closest(".chat-redirect-btn");
      if (actionBtn) {
        const href = actionBtn.getAttribute("href");
        if (!href) return;

        // If it targets an internal anchor or contact page on the current site
        if (href.startsWith("#") || href === CONTACT_PAGE_URL || href.includes("/contact-us")) {
          let targetId = "contact-details";
          if (href.includes("consultation") || href === "#book-consultation") {
            targetId = "book-consultation";
          }
          const targetEl = document.getElementById(targetId) || document.getElementById("contact-details") || document.getElementById("inquiry-form");
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
            const firstInput = targetEl.querySelector("input:not([type=hidden]), textarea");
            if (firstInput) {
              setTimeout(() => firstInput.focus(), 600);
            }
            // On mobile viewports, minimize chatbot so user immediately sees the target section
            if (window.innerWidth < 768 && windowEl && bubble) {
              windowEl.classList.remove("active");
              bubble.classList.remove("hidden-bubble");
            }
            return;
          }
        }
      }
    });

    // Comprehensive NLP & Intent Matching Algorithm
    function findBestMatch(userText) {
      const clean = userText.toLowerCase().trim();

      // 1. COMMERCIAL, PRICING & QUOTES (Always prioritize pricing when user asks about cost/quote)
      if (/\b(?:price|pricing|costs?|how\s*much|budget|quotes?|quotation|rates?|estimate|get\s*a?\s*quote|request\s*a?\s*quote)\b/.test(clean)) return 'pricing_quotes';

      // 2. CONSULTATION & SCHEDULING
      if (/\b(?:book|consultation|schedule|appointment|meeting|strategy\s*call|calendly)\b/.test(clean)) return 'consultation_session';

      // 3. SPECIFIC BOOTH DIMENSIONS & SIZES
      if (/\b10\s*(?:x|by|\*)\s*10\b|100\s*sq|10\s*ft\s*booth\b/.test(clean)) return 'dim_10x10';
      if (/\b10\s*(?:x|by|\*)\s*20\b|200\s*sq|20\s*ft\s*booth\b/.test(clean)) return 'dim_10x20';
      if (/\b20\s*(?:x|by|\*)\s*20\b|400\s*sq|\bisland\b/.test(clean)) return 'dim_20x20';
      if (/\b(?:table\s*top|tabletop|6ft|8ft\s*table|pull\s*up|banner\s*stand|retractable)\b/.test(clean)) return 'dim_tabletop';
      if (/\b(?:height|how\s*tall|hanging\s*sign|rigging|ceiling|perimeter)\b/.test(clean)) return 'dim_height';
      if (/\b(?:dimension|dimensions|sizes?|footprint|footprints|measurements?|how\s*big)\b/.test(clean)) return 'dim_general';

      // 4. CONVERSATIONAL & ABOUT INTENTS
      if (/^(?:hi|hello|hey|good\s*morning|good\s*afternoon|good\s*evening|greetings)\b/.test(clean)) return 'greetings';
      if (/\b(?:thank|thanks|appreciate|awesome|perfect|great\s*job)\b/.test(clean)) return 'thanks';
      if (/\b(?:who\s*(?:are\s*you|is\s*radiant)|about\s*(?:us|radiant|company)|experience|history|background)\b/.test(clean)) return 'about_radiant';

      // 5. LOCATION, HOURS & CONTACT DIRECT
      if (/\b(?:location|address|where|showroom|visit|facility|milner|hours|open|when\s*open|toronto|scarborough)\b/.test(clean)) return 'location_hours';
      if (/\b(?:contact|phone|telephone|call|number|email|sales|reach|speak|talk)\b/.test(clean)) return 'contact_info';

      // 6. PRODUCT CATEGORIES (Based on site links)
      if (/\b(?:rent|rental|rentals|renting|lease|hire)\b/.test(clean)) return 'rental_booths';
      if (/\b(?:custom|customized|bespoke|fabrication|fabricate|wood|metal|graphic-oriented|product-oriented)\b/.test(clean)) return 'custom_solutions';
      if (/\b(?:modular|hybrid|truss|vector|reconfigurable|extrusions?)\b/.test(clean)) return 'modular_displays';
      if (/\b(?:portable|pop\s*up|popup|tension\s*fabric|stretch\s*fabric|lightweight)\b/.test(clean)) return 'portable_displays';
      if (/\b(?:accessories|lighting|light\s*box|lightbox|flooring|carpet|furniture|counters?|kiosks?|screens?|tv|monitors?|holograms?)\b/.test(clean)) return 'accessories_equipment';

      // 7. SERVICES CATEGORIES (Based on /services/)
      if (/\b(?:install|installation|dismantle|teardown|assembly|assemble|labor|i&d|union)\b/.test(clean)) return 'service_installation';
      if (/\b(?:3d|render|rendering|renderings|cad|mockup|mockups|layout|drawings?)\b/.test(clean)) return 'service_3d_design';
      if (/\b(?:concierge|white\s*glove|hotel|shuttle|catering|hospitality|booth\s*staff)\b/.test(clean)) return 'service_concierge';
      if (/\b(?:logistics|freight|shipping|storage|warehouse|store|crates?|crating)\b/.test(clean)) return 'service_logistics_storage';
      if (/\b(?:services?|what\s*do\s*you\s*do|solutions?)\b/.test(clean)) return 'services_overview';

      // 8. OTHER INQUIRIES (Portfolio, Timeline, Venues)
      if (/\b(?:portfolio|gallery|photos?|pictures?|past\s*work|previous|clients?|examples?)\b/.test(clean)) return 'portfolio_gallery';
      if (/\b(?:timeline|turnaround|how\s*long|lead\s*time|rush|urgent|deadline|weeks?)\b/.test(clean)) return 'timeline_turnaround';
      if (/\b(?:venues?|cities|city|locations?|convention|centre|center|mtcc|enercare|vegas|las\s*vegas|chicago|orlando|montreal|vancouver)\b/.test(clean)) return 'venues_locations';

      return null;
    }

    // Typing Indicator Helpers
    function showTypingIndicator() {
      if (!msgContainer) return null;
      const row = document.createElement("div");
      row.className = "msg-row bot typing-row";
      row.id = "chat-typing-indicator";
      row.innerHTML = `
        <div class="bubble typing-bubble">
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
        </div>
      `;
      msgContainer.appendChild(row);
      msgContainer.scrollTop = msgContainer.scrollHeight;
      return row;
    }

    function removeTypingIndicator() {
      const el = document.getElementById("chat-typing-indicator");
      if (el) el.remove();
    }

    // User query submission handler with typing animation and explicit intent support
    let typingTimer = null;
    function handleUserQuery(text, explicitIntent = null) {
      if (!text || !text.trim()) return;
      const cleanQuery = text.trim();

      renderUserMessage(cleanQuery);
      if (input) input.value = "";

      if (typingTimer) clearTimeout(typingTimer);
      showTypingIndicator();

      typingTimer = setTimeout(() => {
        removeTypingIndicator();
        typingTimer = null;

        const matchId = (explicitIntent && knowledgeBase[explicitIntent]) ? explicitIntent : findBestMatch(cleanQuery);
        const data = matchId ? knowledgeBase[matchId] : null;

        if (data) {
          renderBotMessage(data.answer, data.links || [], data.chips || []);
        } else {
          // Accurate, structured fallback with suggestions and direct contacts
          const fallbackText = "• I don't have the exact details on that specific question yet.\n• Our Toronto trade show specialists can answer your question immediately!\n• Call us directly at <strong>416-412-0500</strong> or email <strong>sales@radiantexhibits.com</strong>.\n• You can also visit our Contact Us page to request a custom quote:";
          
          renderBotMessage(fallbackText, [
            { url: CONTACT_PAGE_URL, label: "Get a Quote (Contact Us)" },
            { url: "tel:4164120500", label: "Call 416-412-0500" }
          ], [
            { label: "💰 Pricing & Quotes", query: "How much does a trade show booth cost?", intent: "pricing_quotes" },
            { label: "📐 Booth Dimensions", query: "What booth dimensions and sizes do you offer?", intent: "dim_general" },
            { label: "🏢 Turnkey Rentals", query: "Tell me about trade show booth rentals", intent: "rental_booths" },
            { label: "🎨 Custom Exhibits", query: "What custom booth design options do you offer?", intent: "custom_solutions" }
          ]);
        }
      }, 450);
    }

    function renderUserMessage(text) {
      if (!msgContainer) return;
      const row = document.createElement("div");
      row.className = "msg-row user";
      row.innerHTML = `<div class="bubble">${escapeHTML(text)}</div>`;
      msgContainer.appendChild(row);
      msgContainer.scrollTop = msgContainer.scrollHeight;
    }

    function renderBotMessage(text, links = [], chips = []) {
      if (!msgContainer) return;

      const row = document.createElement("div");
      row.className = "msg-row bot";

      // Convert line breaks to clean HTML paragraphs/breaks
      const formattedText = text.replace(/\n/g, "<br>");
      let innerHTML = `<div class="bubble">${formattedText}</div>`;

      // Render Direct Action Buttons
      if (links && links.length > 0) {
        innerHTML += `<div class="chat-action-wrapper">`;
        links.forEach((l) => {
          const isExternal = l.url.startsWith("http") && !l.url.includes("contact-us");
          const targetAttr = isExternal ? 'target="_blank" rel="noopener noreferrer"' : '';
          innerHTML += `<a href="${l.url}" class="chat-redirect-btn" ${targetAttr}>${escapeHTML(l.label)}</a>`;
        });
        innerHTML += `</div>`;
      }

      // Render Suggested Follow-up Chips with explicit intent attributes
      if (chips && chips.length > 0) {
        innerHTML += `<div class="chat-chips-container">`;
        chips.forEach((c) => {
          const intentAttr = c.intent ? `data-intent="${escapeHTML(c.intent)}"` : '';
          innerHTML += `<button type="button" class="chat-chip-btn" ${intentAttr} data-query="${escapeHTML(c.query)}">${escapeHTML(c.label)}</button>`;
        });
        innerHTML += `</div>`;
      }

      // Minimal footer info
      innerHTML += `<div class="chat-fallback-info">Need immediate assistance? Call <a href="tel:416-412-0500">416-412-0500</a> or email <a href="mailto:sales@radiantexhibits.com">sales@radiantexhibits.com</a>.</div>`;

      row.innerHTML = innerHTML;
      msgContainer.appendChild(row);
      msgContainer.scrollTop = msgContainer.scrollHeight;
    }

    function escapeHTML(str) {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    if (sendBtn) {
      sendBtn.addEventListener("click", () => {
        if (input) handleUserQuery(input.value);
      });
    }

    if (input) {
      input.addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          handleUserQuery(input.value);
        }
      });
    }
  }

  setupChatUI();
  document.addEventListener("astro:after-swap", setupChatUI);
</script>

