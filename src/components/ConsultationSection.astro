---
import { Calendar, Sparkles, CheckCircle } from 'lucide-astro';

const GoogleCalenderUrl = import.meta.env.PUBLIC_GOOGLE_CALENDER_URL;

const consultationBenefits = [
  "Comprehensive Booth Life-Cycle Planning",
  "Custom 3D Concept & Layout Review",
  "Transparent Cost & Budget Breakdown",
  "Material Selection & Structural Advice",
  "Turnkey Installation & Dismantling Schedule",
  "Venue Regulation & Compliance Guidance"
];
---

<section id="book-consultation" class="relative py-14 md:py-24 bg-white font-sans overflow-hidden border-t border-slate-200">
  <!-- Subtle ambient background gradients -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-primary/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    
    <!-- Section Header -->
    <div data-reveal data-delay="1" class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider mb-4">
        <Calendar class="w-3.5 h-3.5" />
        Schedule Online
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-[1000] text-slate-900 tracking-tight leading-tight mb-4">
        Book a Free Consultation
      </h2>

      <p class="text-slate-600 text-base md:text-lg leading-relaxed">
        Speak directly with our senior exhibit consultants to strategize your next trade show appearance, explore 3D concepts, and get an accurate budget estimate.
      </p>
    </div>

    <!-- What is Included in Consultation Box -->
    <div 
      data-reveal 
      data-delay="2"
      class="bg-slate-50 border border-slate-200/90 rounded-2xl md:rounded-3xl p-6 sm:p-8 md:p-10 mb-10 md:mb-14 shadow-sm"
    >
      <div class="flex items-center gap-2.5 mb-6 pb-4 border-b border-slate-200">
        <Sparkles class="w-5 h-5 text-primary" />
        <h3 class="text-base sm:text-lg font-black uppercase tracking-wider text-slate-900">
          What's Included in Your Free Strategy Session:
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        {consultationBenefits.map((benefit) => (
          <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-slate-200/60 shadow-xs">
            <CheckCircle class="w-5 h-5 text-primary shrink-0 mt-0.5" />
            <span class="text-sm font-bold text-slate-800 leading-snug">{benefit}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Calendar Section (same as thankyou) -->
    <div 
      id="booking-calendar"
      data-reveal 
      data-delay="3"
      class="bg-white rounded-2xl shadow-xl overflow-hidden max-w-5xl mx-auto border border-gray-200 scroll-mt-28"
    >
      <iframe
        src={GoogleCalenderUrl}
        width="100%"
        height="700"
        frameborder="0"
        class="w-full"
        loading="lazy"
      ></iframe>
    </div>

  </div>
</section>

<style>
  #booking-calendar {
    scroll-margin-top: 120px;
  }

  iframe {
    border: none;
  }
</style>
