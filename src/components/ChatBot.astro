<div class="chatbot-wrapper">

  <button id="chat-bubble" class="chat-bubble" aria-label="Open Chat">
    <div class="bubble-pulse"></div>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="relative z-10">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
    </svg>
  </button>

  <div id="chat-window" class="chat-window">

    <div class="chat-header">
      <div class="header-left">
        <div class="avatar-container">
          <div class="online-dot"></div>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="10" rx="2" />
            <circle cx="12" cy="5" r="2" />
            <path d="M12 7v4" />
          </svg>
        </div>
        <div>
          <h3>Radiant Assistant</h3>
          <p>Instant Answers &bull; Online</p>
        </div>
      </div>
      <div class="header-actions">
        <button id="clear-chat" class="header-action-btn" title="Reset Conversation">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
          </svg>
        </button>
        <button id="close-chat" class="close-btn" aria-label="Close Chat">✕</button>
      </div>
    </div>

    <div id="chat-messages" class="chat-messages-area">
      <!-- Injected via JavaScript with Welcome & Interactive Quick Chips -->
    </div>

    <div class="chat-input-area">
      <div class="input-pill">
        <input type="text" id="chat-input" placeholder="Type a question (e.g. pricing, rental, location)..." autocomplete="off" />
        <button id="send-chat" class="send-btn" aria-label="Send Message">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  function setupChatUI() {
    const bubble = document.getElementById("chat-bubble");
    const windowEl = document.getElementById("chat-window");
    const closeBtn = document.getElementById("close-chat");
    const clearBtn = document.getElementById("clear-chat");
    const sendBtn = document.getElementById("send-chat");
    const input = document.getElementById("chat-input");
    const msgContainer = document.getElementById("chat-messages");

    // Quick suggestion topics for instant exploration
    const quickChips = [
      { label: "💰 Pricing & Quotes", query: "How much does a trade show booth cost?" },
      { label: "🏢 Booth Rentals", query: "Tell me about trade show booth rentals" },
      { label: "🎨 Custom Exhibits", query: "What custom booth design options do you offer?" },
      { label: "📍 Location & Hours", query: "Where is your showroom and office located?" },
      { label: "📅 Book Consultation", query: "How can I book a free booth strategy consultation?" },
      { label: "🛠️ Installation & Dismantle", query: "Do you handle on-site installation and teardown?" },
      { label: "📞 Contact Directly", query: "What is your phone number and email address?" },
    ];

    // Comprehensive Radiant Exhibits Knowledge Base (Zero API Key, Instant Responses)
    const knowledgeBase = [
      {
        id: "greetings",
        keywords: ["hello", "hi", "hey", "good morning", "good afternoon", "greetings", "howdy", "sup", "yo"],
        answer: "Hello! 👋 Welcome to Radiant Exhibits, Canada's #1 custom trade show booth specialists. How can I assist you with your upcoming event today?\n\nFeel free to type any question or pick a popular topic below:",
        showChips: true
      },
      {
        id: "thanks",
        keywords: ["thank", "thanks", "thank you", "appreciate", "great", "awesome", "perfect", "good job"],
        answer: "You're very welcome! 😊 Our team is always here to make your exhibiting experience stress-free. Let us know if you need anything else, or give us a call directly at 416-412-0500.",
        links: [
          { url: "#contact-details", label: "Send an Inquiry" },
          { url: "#book-consultation", label: "Book Free Consultation" }
        ]
      },
      {
        id: "about_company",
        keywords: ["who are you", "what is radiant exhibits", "about radiant", "about us", "company", "who is radiant"],
        answer: "Radiant Exhibits is Canada's premier trade show booth builder based in Toronto, Ontario. We offer complete turnkey exhibit solutions across North America—including 3D concept design, in-house custom fabrication, modular systems, turnkey rentals, equipment accessories, and on-site installation/dismantling.",
        links: [
          { url: "https://radiantexhibits.com/about-us", label: "About Radiant Exhibits" },
          { url: "https://radiantexhibits.com/gallery", label: "View Our Portfolio" }
        ]
      },
      {
        id: "pricing_quotes",
        keywords: ["price", "pricing", "cost", "how much", "budget", "quote", "quotation", "rate", "rates", "estimate", "expensive", "cheap", "charge"],
        answer: "Trade show booth pricing depends on your space dimensions (e.g. 10x10, 10x20, 20x20), structure style (custom build vs. modular or rental), finishes, lighting, and venue requirements.\n\nWe provide 100% transparent, itemized quotes with no hidden fees! You can fill out our quick inquiry form above or schedule a free strategy session with an estimator.",
        links: [
          { url: "#contact-details", label: "Request a Custom Quote" },
          { url: "#book-consultation", label: "Schedule Free Consultation" }
        ]
      },
      {
        id: "rentals",
        keywords: ["rental", "rent", "renting", "lease", "hire", "temporary", "rental booth", "rent booths"],
        answer: "Our turnkey rental booth packages are the perfect cost-effective solution for single-show exhibitors or international brands! Packages include structural framework, custom branded graphics, lighting, delivery, on-site assembly, and post-show dismantling.",
        links: [
          { url: "https://radiantexhibits.com/category/rental", label: "View Rental Solutions" },
          { url: "#contact-details", label: "Inquire About Rentals" }
        ]
      },
      {
        id: "custom_booths",
        keywords: ["custom", "bespoke", "fabrication", "fabricate", "build", "builder", "construction", "manufacture", "custom booth", "custom exhibits", "island booth", "unique"],
        answer: "Looking for a standout, 100% bespoke presence? Our in-house engineering and fabrication team creates high-impact custom exhibits from 3D rendering to precision manufacturing with premium woods, metals, fabrics, and dynamic lighting. Perfect for 10x20, 20x20, and larger island exhibits.",
        links: [
          { url: "https://radiantexhibits.com/gallery", label: "View Custom Booth Portfolio" },
          { url: "#contact-details", label: "Request Custom Design" }
        ]
      },
      {
        id: "modular_displays",
        keywords: ["modular", "hybrid", "truss", "vector", "reconfigurable", "expandable", "flexible", "modular booth"],
        answer: "Our modular display systems (Vector, Hybrid, Truss) give your brand ultimate flexibility. The same modular hardware can effortlessly expand or downsize between shows (for instance, converting a 10x20 booth into two 10x10 displays), significantly reducing your annual trade show costs.",
        links: [
          { url: "https://radiantexhibits.com/", label: "Explore Modular Systems" },
          { url: "#contact-details", label: "Ask About Modular Displays" }
        ]
      },
      {
        id: "portable_displays",
        keywords: ["portable", "pop up", "popup", "tension fabric", "banner stand", "lightweight", "tabletop", "easy setup", "quick setup", "self setup"],
        answer: "Need an easy, lightweight display? We supply premium tension fabric backdrops, pop-up displays, and retractable banner stands that set up in minutes with zero tools required. Ideal for 8ft and 10ft spaces or traveling sales teams.",
        links: [
          { url: "https://radiantexhibits.com/", label: "View Portable Displays" }
        ]
      },
      {
        id: "installation_dismantle",
        keywords: ["installation", "install", "dismantle", "tear down", "teardown", "assembly", "assemble", "setup", "set up", "labor", "union", "i&d", "on-site", "build up"],
        answer: "We provide complete, certified Installation & Dismantle (I&D) services across North America. Our professional team handles venue freight delivery, structural assembly, electrical/lighting connections, flooring installation, union regulations compliance, and post-event teardown so you can focus entirely on your clients.",
        links: [
          { url: "https://radiantexhibits.com/services/installation", label: "Installation Details" },
          { url: "#contact-details", label: "Book I&D Services" }
        ]
      },
      {
        id: "design_3d",
        keywords: ["3d", "rendering", "render", "design", "mockup", "concept", "layout", "visual", "drawings", "graphic design"],
        answer: "Before anything goes to physical production, our in-house 3D design team crafts ultra-realistic 3D architectural mockups of your booth. You can virtually walk through sightlines, evaluate graphics and lighting placements, and optimize visitor circulation to maximize trade show ROI.",
        links: [
          { url: "#book-consultation", label: "Schedule 3D Design Review" }
        ]
      },
      {
        id: "consultation",
        keywords: ["consultation", "consult", "book", "appointment", "meeting", "strategy", "schedule", "call", "calendly", "online meeting"],
        answer: "You can book a complimentary 30-minute online strategy consultation with our senior trade show experts! We cover:\n• Booth Life-Cycle & Timeline Planning\n• Custom 3D Concept & Layout Review\n• Transparent Cost & Budget Breakdown\n• Material Selection & Structural Advice\n• Turnkey Installation Schedules & Visibility Tips",
        links: [
          { url: "#book-consultation", label: "Book Consultation on Calendar" }
        ]
      },
      {
        id: "location_hours",
        keywords: ["location", "address", "where", "visit", "showroom", "office", "facility", "directions", "map", "hours", "open", "toronto"],
        answer: "📍 Office & Showroom Location:\n150 Milner Ave, Unit #19, Toronto, ON M1S 3R3, Canada.\n\n🕒 Hours of Operation:\nMonday – Friday: 9:00 AM – 5:30 PM EST.\n\nVisits are welcome to inspect modular frames, lighting, and sample material finishes in person!",
        links: [
          { url: "https://maps.google.com/?q=150+Milner+Ave,+Unit+%2319,+Toronto,+ON+M1S+3R3", label: "Open in Google Maps" }
        ]
      },
      {
        id: "contact_info",
        keywords: ["contact", "phone", "telephone", "call", "number", "email", "sales", "reach", "talk", "speak", "agent", "human"],
        answer: "Connect directly with our team:\n• Local (Toronto): 416-412-0500\n• Toll-Free (North America): 1-855-412-0500\n• Direct Email: sales@radiantexhibits.com\n• Facility: 150 Milner Ave, Unit #19, Toronto, ON M1S 3R3\n\nWe respond to all online inquiries within 24 business hours!",
        links: [
          { url: "tel:4164120500", label: "Call 416-412-0500" },
          { url: "mailto:sales@radiantexhibits.com", label: "Send an Email" }
        ]
      },
      {
        id: "sizes",
        keywords: ["size", "sizes", "10x10", "10x20", "20x20", "20x30", "30x30", "dimension", "dimensions", "inline", "corner", "island"],
        answer: "We engineer trade show displays for all footprint sizes:\n• 10x10 Inline Booths: Compact, high-visibility backdrops & counters\n• 10x20 Booths: Extra footprint for product demos & meeting spaces\n• 20x20+ Island Exhibits: 360-degree visibility, high-hanging signs & private conference rooms\n• Custom Sizes: Engineered to your exact booth footprint.",
        links: [
          { url: "#contact-details", label: "Get a Size-Specific Quote" }
        ]
      },
      {
        id: "accessories_lighting",
        keywords: ["accessories", "lighting", "lightbox", "led", "flooring", "carpet", "furniture", "counter", "kiosk", "screen", "tv", "hologram", "table", "chair"],
        answer: "We provide complete trade show accessories and equipment rentals:\n• Vibrant LED Backlit Lightboxes\n• Custom Reception Counters & Display Kiosks\n• Hardwood, Vinyl, and Foam Trade Show Flooring\n• AV Video Screens, TV Mounts & Digital Displays\n• Lounge Seating, Barstools, and Meeting Tables",
        links: [
          { url: "https://radiantexhibits.com/", label: "Explore Accessories" }
        ]
      },
      {
        id: "logistics_storage",
        keywords: ["logistics", "shipping", "freight", "transport", "storage", "warehouse", "store", "dismantle logistics", "crate", "crating"],
        answer: "We handle the complete physical logistics lifecycle: secure protective crating, coordinated freight to and from the convention hall, customs handling for cross-border events, and safe temperature-controlled warehouse storage between shows.",
        links: [
          { url: "https://radiantexhibits.com/services/", label: "View Logistics Services" }
        ]
      },
      {
        id: "service_areas",
        keywords: ["area", "areas", "city", "cities", "canada", "usa", "us", "america", "montreal", "vancouver", "vegas", "las vegas", "chicago", "orlando", "venue", "mtcc", "enercare"],
        answer: "We provide turnkey exhibit services across North America:\n• Canada: Toronto (MTCC, Enercare, International Centre), Montreal, Vancouver, Calgary, Ottawa, Edmonton\n• USA: Las Vegas, Chicago, Orlando, Atlanta, Anaheim, New York, Dallas, Boston, and more.",
        links: [
          { url: "#contact-details", label: "Check Your Venue Schedule" }
        ]
      },
      {
        id: "timeline",
        keywords: ["timeline", "turnaround", "how long", "lead time", "deadline", "weeks", "rush", "urgent", "fast", "speed"],
        answer: "Recommended timelines:\n• Custom Builds: 4 to 8 weeks from design sign-off\n• Modular & Rental Booths: 2 to 4 weeks\n• Portable Displays: 1 to 2 weeks\n\nFacing a tight deadline? We frequently handle rush turnarounds—call us at 416-412-0500 to discuss your show dates immediately!",
        links: [
          { url: "tel:4164120500", label: "Call for Rush Availability" }
        ]
      },
      {
        id: "portfolio",
        keywords: ["portfolio", "gallery", "examples", "photos", "pictures", "past work", "case studies", "previous booths", "past clients"],
        answer: "We have created award-winning exhibits across healthcare, technology, retail, agriculture, aerospace, and manufacturing sectors. Explore hundreds of real booth photos in our project portfolio!",
        links: [
          { url: "https://radiantexhibits.com/gallery", label: "Browse Project Gallery" }
        ]
      }
    ];

    // Build the Initial Welcome Message HTML
    function getWelcomeHTML() {
      let chipsHTML = `<div class="chat-chips-container">`;
      quickChips.forEach((chip) => {
        chipsHTML += `<button type="button" class="chat-chip-btn" data-query="${chip.query}">${chip.label}</button>`;
      });
      chipsHTML += `</div>`;

      return `
        <div class="msg-row bot">
          <div class="bubble">Hi 👋 Welcome to <strong>Radiant Exhibits</strong>! How can I help you today? Ask any question or tap a quick topic below:</div>
          ${chipsHTML}
        </div>
      `;
    }

    // Initialize messages container
    if (msgContainer) {
      msgContainer.innerHTML = getWelcomeHTML();
      bindChipButtons(msgContainer);
    }

    // Toggle Chat Window
    if (bubble && windowEl) {
      bubble.addEventListener("click", () => {
        windowEl.classList.add("active");
        bubble.classList.add("hidden-bubble");
        if (input) setTimeout(() => input.focus(), 200);
      });
    }

    if (closeBtn && windowEl && bubble) {
      closeBtn.addEventListener("click", () => {
        windowEl.classList.remove("active");
        bubble.classList.remove("hidden-bubble");
      });
    }

    if (clearBtn && msgContainer) {
      clearBtn.addEventListener("click", () => {
        msgContainer.innerHTML = getWelcomeHTML();
        bindChipButtons(msgContainer);
      });
    }

    // Bind event listeners to chip buttons
    function bindChipButtons(context) {
      const chips = context.querySelectorAll(".chat-chip-btn");
      chips.forEach((chip) => {
        chip.addEventListener("click", (e) => {
          e.preventDefault();
          const query = chip.getAttribute("data-query");
          if (query) {
            handleUserQuery(query);
          }
        });
      });
    }

    // Natural Language Keyword & Intent Matching Algorithm
    function findBestMatch(userText) {
      const clean = userText.toLowerCase().replace(/[^\w\s]/g, " ").trim();
      const words = clean.split(/\s+/).filter(w => w.length > 1);

      let bestItem = null;
      let highestScore = 0;

      for (const item of knowledgeBase) {
        let score = 0;

        for (const kw of item.keywords) {
          const kwLower = kw.toLowerCase();

          // Exact phrase match bonus
          if (clean.includes(kwLower)) {
            score += kwLower.length * 2.5;
          }

          // Individual word match
          for (const word of words) {
            if (kwLower === word) {
              score += 10;
            } else if (kwLower.includes(word) && word.length > 3) {
              score += 4;
            }
          }
        }

        if (score > highestScore) {
          highestScore = score;
          bestItem = item;
        }
      }

      // Minimum confidence threshold
      if (highestScore >= 6) {
        return bestItem;
      }

      return null;
    }

    // User submission handler
    function handleUserQuery(text) {
      if (!text || !text.trim()) return;
      const cleanQuery = text.trim();

      renderUserMessage(cleanQuery);

      if (input) input.value = "";

      // Quick simulated natural typing delay for smooth UX
      setTimeout(() => {
        const match = findBestMatch(cleanQuery);

        if (match) {
          renderBotMessage(match.answer, match.links || [], match.showChips || false);
        } else {
          // Polite fallback with direct phone / email and quick topics
          const fallbackText = "I don't have the exact details on that specific question yet, but our Toronto trade show specialists can answer immediately! Call us at 416-412-0500 or email sales@radiantexhibits.com.\n\nYou can also explore one of our popular topics below:";
          renderBotMessage(fallbackText, [
            { url: "tel:4164120500", label: "Call 416-412-0500" },
            { url: "#contact-details", label: "Send Us an Inquiry" }
          ], true);
        }
      }, 150);
    }

    function renderUserMessage(text) {
      if (!msgContainer) return;
      const row = document.createElement("div");
      row.className = "msg-row user";
      row.innerHTML = `<div class="bubble">${escapeHTML(text)}</div>`;
      msgContainer.appendChild(row);
      msgContainer.scrollTop = msgContainer.scrollHeight;
    }

    function renderBotMessage(text, links = [], showChips = false) {
      if (!msgContainer) return;

      const row = document.createElement("div");
      row.className = "msg-row bot";

      // Format linebreaks into readable HTML
      const formattedText = escapeHTML(text).replace(/\n/g, "<br>");
      let innerHTML = `<div class="bubble">${formattedText}</div>`;

      // Render Action Buttons
      if (links && links.length > 0) {
        innerHTML += `<div class="chat-action-wrapper">`;
        links.forEach((l) => {
          innerHTML += `<a href="${l.url}" class="chat-redirect-btn">${escapeHTML(l.label)}</a>`;
        });
        innerHTML += `</div>`;
      }

      // Append Chips if requested
      if (showChips) {
        innerHTML += `<div class="chat-chips-container">`;
        quickChips.forEach((chip) => {
          innerHTML += `<button type="button" class="chat-chip-btn" data-query="${chip.query}">${chip.label}</button>`;
        });
        innerHTML += `</div>`;
      }

      // Support footer info
      innerHTML += `<div class="chat-fallback-info">Need immediate assistance? Call <a href="tel:416-412-0500">416-412-0500</a> or email <a href="mailto:sales@radiantexhibits.com">sales@radiantexhibits.com</a>.</div>`;

      row.innerHTML = innerHTML;
      msgContainer.appendChild(row);

      // Rebind chip clicks if any chips were rendered
      if (showChips) {
        bindChipButtons(row);
      }

      msgContainer.scrollTop = msgContainer.scrollHeight;
    }

    function escapeHTML(str) {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    if (sendBtn) {
      sendBtn.addEventListener("click", () => {
        if (input) handleUserQuery(input.value);
      });
    }

    if (input) {
      input.addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          handleUserQuery(input.value);
        }
      });
    }
  }

  setupChatUI();
  document.addEventListener("astro:after-swap", setupChatUI);
</script>

<style is:global>
  .chatbot-wrapper {
    position: fixed;
    right: 52px;
    bottom: 30px;
    z-index: 99999;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* FLOATING TRIGGER BUTTON */
  .chat-bubble {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: linear-gradient(135deg, #01152b, #06396f);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 4px 16px rgba(1, 21, 43, 0.25);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.1);
  }
  .chat-bubble:hover { transform: scale(1.06); }
  .hidden-bubble { opacity: 0; transform: scale(0); pointer-events: none; }
  .bubble-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(41, 151, 201, 0.2);
    animation: pulse 2.5s infinite;
  }

  /* WINDOW LAYOUT CONTAINER */
  .chat-window {
    width: 375px;
    height: 570px;
    background: #eef4fb;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: absolute;
    bottom: 0;
    right: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.96);
    transition: all 0.25s cubic-bezier(0.075, 0.82, 0.165, 1);
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  .chat-window.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* HEADER ELEMENT UI */
  .chat-header {
    background: linear-gradient(135deg, #01152b, #06396f);
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: none;
  }
  .header-left { display: flex; align-items: center; gap: 10px; }
  .avatar-container {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .header-left h3 { margin: 0; font-size: 13.5px; font-weight: 700; color: #ffffff; }
  .header-left p { margin: 1px 0 0 0; font-size: 11px; color: #6ee7b7; font-weight: 500; }
  .online-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    position: absolute;
    bottom: 0;
    right: 0;
    border: 1.5px solid white;
  }
  .header-actions { display: flex; align-items: center; gap: 4px; }
  .close-btn, .header-action-btn {
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.75);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
  }
  .close-btn:hover, .header-action-btn:hover { background: rgba(255,255,255,0.18); color: #ffffff; }

  /* MESSAGE SCROLL WINDOW */
  .chat-messages-area {
    flex: 1;
    padding: 16px 14px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #f1f5f9;
  }
  .chat-messages-area::-webkit-scrollbar { width: 4px; }
  .chat-messages-area::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

  .msg-row {
    display: flex;
    flex-direction: column;
    width: 100%;
    animation: fadeUp 0.2s ease-out forwards;
  }

  .msg-row.bot { align-items: flex-start; }
  .msg-row.user { align-items: flex-end; }

