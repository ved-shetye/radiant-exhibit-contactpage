---
import { Image } from "astro:assets";

// Import your asset directly from the assets folder
import contactDisplayImage from "../assets/PrefooterImg.jpg";
---

<section
    id="contact"
    class="relative py-7 md:py-10 bg-[#F2FDFA] font-sans flex items-center overflow-hidden"
>
    <!-- ambient backdrop -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[400px] bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
    <div
        class="absolute inset-0 opacity-[0.035] pointer-events-none"
        style="background-image: radial-gradient(circle, #1b82b2 1px, transparent 1px); background-size: 24px 24px;"
    ></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-8 w-full">
        <div class="grid lg:grid-cols-[4fr_6fr] gap-6 md:gap-8 lg:gap-10 items-center">
            <div class="flex justify-center lg:justify-start">
                <a
                    href="https://radiantexhibits.com/trade-show-booth-selector"
                    class="group relative w-[280px] h-[280px] sm:w-[310px] sm:h-[310px] md:w-[350px] md:h-[350px] rounded-full bg-white shadow-lg ring-1 ring-sky-200/70 flex flex-col items-center justify-between p-5 sm:p-6 md:p-7 text-center overflow-hidden transition-all duration-500 ease-out hover:shadow-xl hover:ring-primary/40 hover:-translate-y-0.5 select-none"
                >
                    <!-- dashed compass-style ring -->
                    <div class="absolute inset-2.5 sm:inset-3 md:inset-3.5 rounded-full border-2 border-dashed border-primary/15"></div>

                    <!-- tick marks like a dial -->
                    <div class="absolute inset-0" aria-hidden="true">
                        <div class="absolute top-[5%] left-1/2 -translate-x-1/2 w-px h-2.5 bg-primary/20"></div>
                        <div class="absolute bottom-[5%] left-1/2 -translate-x-1/2 w-px h-2.5 bg-primary/20"></div>
                        <div class="absolute left-[5%] top-1/2 -translate-y-1/2 w-2.5 h-px bg-primary/20"></div>
                        <div class="absolute right-[5%] top-1/2 -translate-y-1/2 w-2.5 h-px bg-primary/20"></div>
                    </div>

                    <!-- Base Content Container: smooth fade out / fade back in -->
                    <div class="relative flex flex-col items-center justify-center flex-1 space-y-1.5 md:space-y-2 transition-all duration-500 group-hover:opacity-10 group-hover:blur-sm">
                        <span class="text-[9px] md:text-[10px] font-bold tracking-[0.2em] uppercase text-secondary">
                            Find Your Fit
                        </span>

                        <h2 class="text-base sm:text-lg md:text-2xl !text-primary font-[900] leading-tight tracking-tight uppercase">
                            Trade Show <br /> Booth Selector
                        </h2>

                        <div class="h-px w-8 md:w-10 bg-secondary/30"></div>

                        <p class="capitalize text-xs sm:text-[13px] md:text-sm font-semibold text-secondary max-w-[190px] md:max-w-[230px] leading-snug">
                            Not certain exactly what type of booth you need?
                        </p>

                        <!-- shop/storefront icon -->
                        <div class="text-primary transition-transform duration-700 ease-out group-hover:rotate-[360deg] mb-1">
                            <!--?xml version="1.0" encoding="utf-8"?-->
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                class="responsive-shop-icon"
                            >
                                <style>
                                    .responsive-shop-icon {
                                        width: 40px;
                                        height: 40px;
                                    }
                                    @media (min-width: 768px) {
                                        .responsive-shop-icon {
                                            width: 54px;
                                            height: 54px;
                                        }
                                    }
                                </style>
                                <path
                                    d="M9.5 21.5V18.5C9.5 17.5654 9.5 17.0981 9.70096 16.75C9.83261 16.522 10.022 16.3326 10.25 16.201C10.5981 16 11.0654 16 12 16C12.9346 16 13.4019 16 13.75 16.201C13.978 16.3326 14.1674 16.522 14.299 16.75C14.5 17.0981 14.5 17.5654 14.5 18.5V21.5"
                                    stroke="#1C274C"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                ></path>
                                <path
                                    d="M21 22H9M3 22H5.5"
                                    stroke="#1C274C"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                ></path>
                                <path
                                    d="M19 22V15"
                                    stroke="#1C274C"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                ></path>
                                <path
                                    d="M5 22V15"
                                    stroke="#1C274C"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                ></path>
                                <path
                                    d="M11.9999 2H7.47214C6.26932 2 5.66791 2 5.18461 2.2987C4.7013 2.5974 4.43234 3.13531 3.89443 4.21114L2.49081 7.75929C2.16652 8.57905 1.88279 9.54525 2.42867 10.2375C2.79489 10.7019 3.36257 11 3.99991 11C5.10448 11 5.99991 10.1046 5.99991 9C5.99991 10.1046 6.89534 11 7.99991 11C9.10448 11 9.99991 10.1046 9.99991 9C9.99991 10.1046 10.8953 11 11.9999 11C13.1045 11 13.9999 10.1046 13.9999 9C13.9999 10.1046 14.8953 11 15.9999 11C17.1045 11 17.9999 10.1046 17.9999 9C17.9999 10.1046 18.8953 11 19.9999 11C20.6373 11 21.205 10.7019 21.5712 10.2375C22.1171 9.54525 21.8334 8.57905 21.5091 7.75929L20.1055 4.21114C19.5676 3.13531 19.2986 2.5974 18.8153 2.2987C18.332 2 17.7306 2 16.5278 2H16"
                                    stroke="#1C274C"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                ></path>
                            </svg>
                        </div>
                    </div>

                    <!-- Overlay: Controls exit speeds specifically so everything flows smoothly backward -->
                    <div class="absolute inset-0 flex items-center justify-center p-5 sm:p-6 md:p-7 opacity-0 pointer-events-none transition-all duration-300 ease-in-out bg-white/90 backdrop-blur-md transform scale-95 group-hover:opacity-100 group-hover:scale-100 group-hover:duration-500 group-hover:delay-300">
                        <p class="text-xs sm:text-[13px] md:text-sm text-slate-800 font-bold leading-relaxed">
                            Not certain exactly what type of booth you need?
                            <span class="text-primary block mt-1.5">
                                Answer the next few simple questions
                            </span>{" "}
                            and we'll help guide you to a booth solution that's
                            right for you.
                        </p>
                    </div>

                    <!-- Bottom Action Bar -->
                    <div class="relative z-20 w-full mt-auto">
                        <div class="inline-flex items-center gap-1.5 bg-primary group-hover:bg-black text-white px-4 py-1.5 md:px-5 md:py-2 rounded-full text-[11px] md:text-xs font-black tracking-wider uppercase transition-colors duration-300">
                            Click to Start
                            <svg
                                class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-0.5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M5 12h14M13 5l7 7-7 7"></path>
                            </svg>
                        </div>
                    </div>
                </a>
            </div>

            <div class="w-full max-w-xl lg:max-w-none mx-auto">
                <div class="relative">
                    <div class="absolute -inset-2 md:-inset-3 bg-primary/25 rounded-2xl md:rounded-[1.6rem] -rotate-1.5 md:-rotate-2 transition-transform duration-500"></div>
                    <Image
                        src={contactDisplayImage}
                        alt="Radiant Exhibits Custom Trade Show Booth Solution Display Layout"
                        class="relative w-full h-[180px] sm:h-[220px] md:h-[270px] lg:h-[290px] object-cover rounded-xl md:rounded-2xl shadow-lg border border-sky-100"
                        loading="lazy"
                    />
                    <div class="absolute -bottom-2.5 -right-2.5 md:-bottom-3 md:-right-3 bg-primary text-white rounded-lg md:rounded-xl px-3 py-1.5 md:px-4 md:py-2 shadow-md">
                        <p class="text-[9px] md:text-[11px] font-bold tracking-[0.15em] uppercase leading-none">
                            Custom Layouts
                        </p>
                        <p class="text-[8px] md:text-[10px] text-white/80 leading-none mt-0.5">
                            Built for your brand
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
