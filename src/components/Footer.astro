---
import { Image } from "astro:assets";
import logoImg from "../assets/logo.png";

const contactInfo = {
  email: "sales@radiantexhibits.com",
  phone: "416-412-0500",
  address: "150 Milner Ave Unit #19, Toronto, ON M1S 3R3",
  tagline: "#1 Custom Trade Show Booth Exhibits in Canada",
  termsUrl: "https://radiantexhibits.com/terms",
};
---

<footer
  class="relative bg-[#0077B6] text-white pt-6 pb-5 md:pt-10 md:pb-7 overflow-hidden font-sans"
>
  <!-- Background Accents -->
  <div
    class="absolute top-0 right-0 w-[550px] h-[550px] bg-white/5 rounded-full blur-[110px] pointer-events-none -translate-y-1/2 translate-x-1/4"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-black/10 rounded-full blur-[90px] pointer-events-none translate-y-1/3 -translate-x-1/4"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8 z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-y-6 gap-x-6 md:gap-y-12 lg:gap-x-10 pb-6 md:pb-8 border-b border-white/10"
    >
      <!-- Column 1: Logo & Tagline -->
      <div
        class="space-y-3 md:space-y-6 text-center md:text-left md:col-span-4"
      >
        <div class="flex items-center justify-center md:justify-start">
          <a
            href="/"
            class="inline-flex items-center justify-center bg-white px-4 py-2.5 md:px-5 md:py-3 rounded-xl md:rounded-xl shadow-md hover:shadow-lg transition-all duration-300 hover:scale-[1.02]"
          >
            <Image
              src={logoImg}
              alt="Radiant Exhibits Logo"
              class="h-12 md:h-17 w-auto object-contain"
            />
          </a>
        </div>
        <p
          class="text-white/80 text-[17px] max-w-[400px] font-medium mx-auto md:mx-0"
        >
          {contactInfo.tagline}
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="text-center md:text-left md:col-span-2">
        <h4
          class="!text-white font-black text-[15px] md:text-[20px] uppercase tracking-[0.2em] mb-3 md:mb-6 relative inline-block after:content-[''] after:absolute after:left-1/2 after:md:left-0 after:-bottom-2 after:-translate-x-1/2 after:md:translate-x-0 after:w-6 after:h-[2px] after:bg-white/40"
        >
          Quick Links
        </h4>
        <ul
          class="space-y-2 md:space-y-3.5 flex flex-col items-center md:items-start mt-1 md:mt-2"
        >
          {
            [
              { label: "Home", href: "https://radiantexhibits.com/" },
              {
                label: "About Us",
                href: "https://radiantexhibits.com/about-us",
              },
              {
                label: "Portfolio Gallery",
                href: "https://radiantexhibits.com/gallery",
              },
              {
                label: "Our Services",
                href: "https://radiantexhibits.com/services",
              },
              {
                label: "Contact Us",
                href: "https://radiantexhibits.com/contact-us/",
              },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="relative block text-white/80 hover:text-white transition-colors duration-300 text-[14px] font-bold tracking-wide py-0.5 group"
                >
                  {link.label}
                  <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-white/40 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Useful Links -->
      <div class="text-center md:text-left md:col-span-3 lg:pl-4">
        <h4
          class="!text-white font-black text-[15px] md:text-[20px] uppercase tracking-[0.2em] mb-3 md:mb-6 relative inline-block after:content-[''] after:absolute after:left-1/2 after:md:left-0 after:-bottom-2 after:-translate-x-1/2 after:md:translate-x-0 after:w-6 after:h-[2px] after:bg-white/40"
        >
          Useful Links
        </h4>
        <ul
          class="space-y-2 md:space-y-3.5 flex flex-col items-center md:items-start mt-1 md:mt-2"
        >
          {
            [
              { label: "Blog", href: "https://radiantexhibits.com/blog" },
              {
                label: "Testimonials",
                href: "https://radiantexhibits.com/testimonials",
              },
              { label: "Videos", href: "https://radiantexhibits.com/video" },
              { label: "Sitemap", href: "https://radiantexhibits.com/sitemap" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="relative block text-white/80 hover:text-white transition-colors duration-300 text-[14px] font-bold tracking-wide py-0.5 group"
                >
                  {link.label}
                  <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-white/40 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 4: Contact Us -->
      <div class="text-center md:text-left md:col-span-3">
        <h4
          class="!text-white font-black text-[15px] md:text-[20px] uppercase tracking-[0.2em] mb-3 md:mb-6 relative inline-block after:content-[''] after:absolute after:left-1/2 after:md:left-0 after:-bottom-2 after:-translate-x-1/2 after:md:translate-x-0 after:w-6 after:h-[2px] after:bg-white/40"
        >
          Contact Us
        </h4>

        <div
          class="space-y-3 md:space-y-5 text-[14.5px] text-white/90 font-medium flex flex-col items-center md:items-start mt-1 md:mt-2"
        >
          <div class="max-w-[280px] md:max-w-none leading-relaxed group">
            <span
              class="text-[12px] uppercase tracking-widest text-white/40 font-black block mb-0.5 text-center md:text-left"
              >Office Location</span
            >
            <p
              class="text-white font-bold transition-colors group-hover:text-white/100 text-[15px]"
            >
              {contactInfo.address}
            </p>
          </div>

          <div class="leading-none">
            <span
              class="text-[12px] uppercase tracking-widest text-white/40 font-black block mb-1 text-center md:text-left"
              >Direct Mail</span
            >
            <a
              href={`mailto:${contactInfo.email}`}
              class="inline-block text-white font-bold hover:text-white/70 transition-colors duration-300 text-[17px]"
            >
              {contactInfo.email}
            </a>
          </div>

          <div class="leading-none">
            <span
              class="text-[12px] uppercase tracking-widest text-white/40 font-black block mb-1 text-center md:text-left"
              >Telephone</span
            >
            <a
              href={`tel:${contactInfo.phone.replace(/-/g, "")}`}
              class="inline-block text-white font-bold hover:text-white/70 transition-colors duration-300 text-[17px]"
            >
              {contactInfo.phone}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Footer Bar -->
    <div
      class="pt-4 md:pt-8 flex flex-col sm:flex-row justify-between items-center gap-2 md:gap-4 text-[10px] md:text-xs text-white/40 uppercase tracking-[0.2em] font-bold text-center"
    >
      <p class="tracking-widest">
        © 2026 Radiant Exhibits. All Rights Reserved.
      </p>

      <div>
        <a
          href={contactInfo.termsUrl}
          class="hover:text-white transition-colors duration-300"
        >
          Terms & Conditions / Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>
